{
  "name": "clickit",
  "version": "0.1.4",
  "private": true,
  "description": "Seleção local de fotografias",
  "author": "ClickIT",
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/apply-nsis-patch.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "models": "node scripts/models.mjs",
    "models:setup": "node scripts/models.mjs",
    "models:test": "node scripts/test-models.mjs",
    "nima:test": "node scripts/nima-test.mjs",
    "nima:convert": "scripts\\models\\run-nima-converter.cmd",
    "face:test": "node scripts/face-probe.mjs",
    "eyes:test": "node scripts/eyes-test.mjs",
    "selection:test": "node scripts/selection-test.mjs",
    "datasets:build": "node scripts/build-validation-datasets.mjs",
    "ranking:validate": "node scripts/ranking-validate.mjs",
    "benchmark:photos": "node scripts/benchmark-photos.mjs",
    "dataset:scale": "node scripts/dataset-scale.mjs",
    "benchmark:scale": "node scripts/benchmark-scale.mjs",
    "benchmark:face-smoke": "node scripts/benchmark-face-smoke.mjs",
    "benchmark:harness": "node scripts/benchmark-harness.mjs",
    "grouping:audit": "node scripts/grouping-audit.mjs",
    "raw:validate": "node scripts/raw-validate.mjs",
    "package:win": "node scripts/verify-models.mjs && npm run check && electron-builder --win --x64",
    "license:keys": "node licensing/src/cli.ts keys",
    "license:create": "node licensing/src/cli.ts create",
    "license:list": "node licensing/src/cli.ts list",
    "license:revoke": "node licensing/src/cli.ts revoke",
    "license:devices": "node licensing/src/cli.ts devices",
    "license:trials": "node licensing/src/cli.ts trials",
    "license:serve": "node licensing/src/index.ts",
    "license:build": "node licensing/build.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@mediapipe/tasks-vision": "0.10.35",
    "@xmldom/xmldom": "0.9.12",
    "exiftool-vendored": "^34.0.0",
    "onnxruntime-node": "^1.22.0",
    "pg": "8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@aws-sdk/lib-storage": "3.1148.0",
    "@eslint/js": "^9.30.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.30.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0",
    "vite": "~8.3.0"
  },
  "build": {
    "appId": "com.clickit.desktop",
    "productName": "ClickIT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/models",
        "to": "models"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/exiftool-vendored*/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ClickIT",
      "installerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
