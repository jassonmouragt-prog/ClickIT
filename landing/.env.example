# Copie para .env.local e preencha. NUNCA commite .env.local.
# Este arquivo não contém segredos reais.

# ------------------------------------------------------------------
# Site
# ------------------------------------------------------------------
# Base pública usada para montar URLs absolutas (webhook/redirect).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL pública do instalador (mesmo arquivo protegido pelo licenciamento).
NEXT_PUBLIC_DOWNLOAD_URL=

# Canal de suporte (WhatsApp/e-mail/página).
NEXT_PUBLIC_SUPPORT_URL=

# Só para sobrescrever a exibição do preço; o preço COBRADO é o de
# src/config/commerce.ts (34700 centavos) e não pode ser alterado aqui.
# NEXT_PUBLIC_PRODUCT_PRICE=347
# NEXT_PUBLIC_PRODUCT_PRICE_DISPLAY=R$ 347,00

# ------------------------------------------------------------------
# InfinitePay (somente servidor — nunca NEXT_PUBLIC_)
# ------------------------------------------------------------------
# InfiniteTag/handle da conta, SEM o símbolo "$" inicial.
INFINITEPAY_HANDLE=

# Host da API de checkout. Padrão: https://api.checkout.infinitepay.io
INFINITEPAY_API_URL=https://api.checkout.infinitepay.io

# URL pública absoluta do webhook desta aplicação.
# Ex.: https://seudominio.com/api/webhooks/infinitepay
INFINITEPAY_WEBHOOK_URL=

# Página de retorno após o pagamento (a rota /pagamento).
# Ex.: https://seudominio.com/pagamento
INFINITEPAY_REDIRECT_URL=

# ------------------------------------------------------------------
# License API (somente servidor — nunca NEXT_PUBLIC_)
# ------------------------------------------------------------------
# Base da License API local/de produção (npm run license:serve).
LICENSE_API_URL=http://127.0.0.1:8085

# Chave de admin da License API (LICENSE_ADMIN_KEY do serviço).
LICENSE_ADMIN_KEY=

# Caminho do SQLite de pedidos. Padrão: data/orders.sqlite
# ORDERS_SQLITE=data/orders.sqlite
