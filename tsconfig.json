{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "preserve", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true, "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true, "resolveJsonModule": true,
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "licensing", "api", "tests", "vite.config.ts"]
}
